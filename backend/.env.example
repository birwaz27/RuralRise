# Copy to .env and replace every secret. Never commit .env.
# Generate a secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# ── Server ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ─────────────────────────────────────────────────────────────
# Local MongoDB is enough for development.
MONGODB_URI=mongodb://127.0.0.1:27017/talent_hub
# Production (MongoDB Atlas): mongodb+srv://<user>:<pass>@cluster.mongodb.net/talent_hub

# ── JWT ───────────────────────────────────────────────────────────────────
# Use two different values, each at least 64 hex characters.
JWT_ACCESS_SECRET=replace_with_64_char_hex_access_secret_replace_with_64_char_hex_aa
JWT_REFRESH_SECRET=replace_with_64_char_hex_refresh_secret_replace_with_64_char_hex_bb
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Frontend URL ──────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── CORS (comma-separated, no wildcard) ──────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Encryption (AES-256-GCM, 32 bytes as 64 hex chars) ───────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── Email (optional — password reset sends only when these are set) ──────
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=your_smtp_api_key
# EMAIL_FROM=noreply@yourdomain.com

# ── Monitoring (optional) ─────────────────────────────────────────────────
# SENTRY_DSN=https://your_sentry_dsn_here

# ── Seed script only (npm run seed). Not required to boot the API. ───────
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=change-this-password
